# Copy to .env and fill in. See README "API keys" table for where to get each.
GROQ_API_KEY=
PEXELS_API_KEY=
# Semantic Scholar API key (richer evidence; degrades to Wikipedia-only if blank)
S2_API_KEY=
# Optional — pipeline works on Hacker News alone without these
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# From scripts/get_youtube_token.py (only needed for upload, not for Phase 0/dry runs)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Instagram Reels cross-post (from scripts/get_instagram_token.py)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Classic GitHub PAT (repo scope) so CI can refresh the IG token secret itself
GH_PAT=
# Optional — WhatsApp notifications via CallMeBot (see README)
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=
